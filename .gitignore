*.class

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Release builds are attached to GitHub Releases, never committed
*.apk
*.aab
*.ipa

# ---------- Python backend -------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Dataset OBD2_panel_opel_2012 (about 187 MB): above GitHub's 100 MB
# file limit, so it stays on the laptop. Any CSV copied into backend/
# is ignored too. Test fixtures in backend/tests/fixtures/ are kept.
backend/*.csv

# Trained model and per-car learning profiles: rebuilt with
#   python train_model.py
backend/saved_models/

# Raw real-car recordings stay on the laptop (privacy, design rule 11)
backend/recordings/

# ---------- Node (only if JavaScript tooling is ever added) ----------
node_modules/

